# Deck generation — the in-site "type a topic" flow, the WebMCP
# create_flashcards tool, and `npm run generate`. Without a key the site still
# plays the built-in deck and says so.
ANTHROPIC_API_KEY=

# Optional: which Claude model writes decks, and how hard it thinks about the
# cards (low | medium | high). medium is the default.
# FLASHCARDS_MODEL=claude-opus-5
# FLASHCARDS_EFFORT=medium

# Optional: set to "off" to keep generated decks text-only. By default the
# generator attaches the Wikipedia lead image of anything a card shows.
# FLASHCARDS_IMAGES=off

# Absolute site URL for the share cards' OpenGraph image URLs. Vercel fills
# this in automatically; set it for other hosts.
# NEXT_PUBLIC_SITE_URL=https://flashcards.example.com

# Sharing decks by link (/d/<id>): a Vercel Blob store's read-write token.
# Linking a store to the project sets it on Vercel; `vercel env pull` brings
# it here. Without it, sharing is unavailable and the site says so.
BLOB_READ_WRITE_TOKEN=
